# ============================
# 온빛타로 환경변수 설정 가이드
# ============================
# 이 파일을 복사해서 .env.local 파일을 만들고 값을 채워주세요.
# cp .env.local.example .env.local

# ----------------------------
# Mock 모드 (API 키 없이 테스트)
# ----------------------------
# true로 설정하면 카카오/토스/Supabase 없이 UI 테스트 가능
NEXT_PUBLIC_MOCK_MODE=true

# ----------------------------
# NextAuth.js 설정
# ----------------------------
# openssl rand -base64 32 명령으로 랜덤 시크릿 생성
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ----------------------------
# 카카오 로그인
# ----------------------------
# https://developers.kakao.com 에서 앱 등록 후 발급
# 플랫폼 > 사이트 도메인에 http://localhost:3000 추가
# 카카오 로그인 > Redirect URI: http://localhost:3000/api/auth/callback/kakao
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ----------------------------
# Supabase 데이터베이스
# ----------------------------
# https://supabase.com 에서 프로젝트 생성 후 발급
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------
# 토스페이먼츠 결제
# ----------------------------
# https://developers.tosspayments.com 에서 발급
# 테스트 키: test_ck_... / 실서비스 키: live_ck_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your-toss-client-key
TOSS_SECRET_KEY=test_sk_your-toss-secret-key

# ----------------------------
# OpenAI (AI 타로 해석)
# ----------------------------
# https://platform.openai.com 에서 발급
# 없으면 Mock 해석 텍스트가 자동으로 사용됩니다
OPENAI_API_KEY=sk-your-openai-api-key
